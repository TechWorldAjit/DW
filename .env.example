# Company Career Directory - Environment Variables

# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster.example.mongodb.net/company_career_directory?retryWrites=true&w=majority

# Secret key for JWT authentication sessions
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Google Gemini API Key (keep server-side only)
GEMINI_API_KEY=your_gemini_api_key_here

# Local Development Port
PORT=5001

# Node Environment
NODE_ENV=development
